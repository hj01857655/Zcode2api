# 监听端口（默认 3010）；LISTEN_ADDR 整体覆盖监听地址（如 0.0.0.0:3010，Docker 用）
PORT=3010
# LISTEN_ADDR=0.0.0.0:3010

# 网关入口 key：空 = 不鉴权（仅本机自用；非 loopback 监听必须设置）
# API_KEY=sk-xxx

# 管理面板（/admin）密码：与 API_KEY 独立；非 loopback 监听必须设置
# ADMIN_PASSWORD=xxx

# 单账号 token 覆盖（账号池 token.json 优先）；自动领套餐开关（0 关闭）
# ZCODE_TOKEN=
# ZCODE_AUTO_CLAIM=1

# request.log 轮转上限（MB，0 关闭）、单请求整体超时（秒，0 关闭）、SSE 心跳间隔（秒，0 关闭）
# REQUEST_LOG_ROTATE_MB=64
# TOTAL_TIMEOUT_SECS=600
# KEEPALIVE_SECS=15

# 上游请求/响应落盘目录（空关闭）与保留文件数
# DUMP_DIR=dumps
# DUMP_MAX_FILES=200
